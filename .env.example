# Server — the app listens on 5000 inside the container. To expose it on a
# different host port, change the port mapping in Coolify's "Ports Mappings"
# section (or edit the `ports:` entry in docker-compose.yml). Env vars do not
# control the published port.
HOST=0.0.0.0
PORT=5000

# Quiz
QUIZ_CODE=

# Volume
COUNT=100
THREADS=8
DELAY_MS=0

# Score control
SCORE_MODE=random
EXACT_SCORE=10
MIN_SCORE=0
MAX_SCORE=10

# Names
NAME_MODE=random
NAME_PREFIX=
NAME_SUFFIX=
MIN_LEN=3
MAX_LEN=8
NAME_LETTERS=true
NAME_DIGITS=true
NAMES_LIST=
